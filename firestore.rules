rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function getUserData() {
      return get(/databases/database/documents/users/request.auth.uid).data;
    }
    
    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }
    
    function isAdmin() {
      return hasRole('admin');
    }
    
    function isVerifier() {
      return hasRole('verifier') || isAdmin();
    }
    
    function isApprovedInstitution() {
      return hasRole('institution') && getUserData().institution_approved == true;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'is_verified']));
      allow delete, update: if isAdmin();
    }

    // Documents Collection
    match /documents/{docId} {
      allow read: if isAuthenticated() && (resource.data.uploaded_by == request.auth.uid || isVerifier());
      allow create: if isAuthenticated() && request.resource.data.uploaded_by == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.uploaded_by == request.auth.uid || isVerifier());
      allow delete: if isAuthenticated() && (resource.data.uploaded_by == request.auth.uid || isAdmin());
    }

    // Verification Results Collection
    match /verification_results/{resultId} {
      allow read: if isAuthenticated();
      allow create, update: if isVerifier();
      allow delete: if isAdmin();
    }

    // Credentials Collection
    match /credentials/{credId} {
      allow read: if true; // Public verification allowed via credential ID
      allow create: if isApprovedInstitution() || isAdmin();
      allow update: if isApprovedInstitution() || isAdmin();
      allow delete: if isAdmin();
    }

    // Institutions Collection
    match /institutions/{instId} {
      allow read: if true; // Public registry directory
      allow create: if isAuthenticated();
      allow update: if isAdmin() || (hasRole('institution') && resource.data.authorized_representatives.hasAny([request.auth.uid]));
      allow delete: if isAdmin();
    }

    // Verification Batches
    match /verification_batches/{batchId} {
      allow read: if isAuthenticated() && (resource.data.uploaded_by == request.auth.uid || isVerifier());
      allow create: if isVerifier();
      allow update: if isVerifier();
      allow delete: if isAdmin();
    }

    // Audit Logs (Append-Only)
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Append-only immutable log
    }

    // Notifications
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && (resource.data.user_id == request.auth.uid || resource.data.user_id == 'all');
      allow update: if isAuthenticated() && resource.data.user_id == request.auth.uid;
      allow create: if isAuthenticated();
      allow delete: if isAuthenticated() && resource.data.user_id == request.auth.uid;
    }
  }
}
