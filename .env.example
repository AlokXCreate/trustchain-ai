# ==============================================================================
# TRUSTCHAIN AI — ENVIRONMENT CONFIGURATION
# ==============================================================================

# --- APPLICATION ENVIRONMENT ---
ENVIRONMENT=development
DEMO_MODE=true
SECRET_KEY=trustchain-ai-enterprise-secret-key-2026-production-ready
API_V1_STR=/api/v1

# --- BACKEND (FastAPI) ---
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]

# --- FIREBASE CONFIGURATION (Backend Admin SDK) ---
# Download serviceAccountKey.json from Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=trustchain-ai-demo
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json
FIREBASE_STORAGE_BUCKET=trustchain-ai-demo.appspot.com

# --- FRONTEND (Vite / React) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=trustchain-ai-demo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=trustchain-ai-demo
VITE_FIREBASE_STORAGE_BUCKET=trustchain-ai-demo.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# --- AI & RAG SERVICES (Phase 2 & 3 Integration Readiness) ---
GEMINI_API_KEY=your-google-gemini-api-key

# --- BLOCKCHAIN & SMART CONTRACTS (Phase 3 Hardhat & Sepolia) ---
BLOCKCHAIN_ENABLED=true
BLOCKCHAIN_NETWORK=hardhat
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CHAIN_ID=31337
BLOCKCHAIN_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
BLOCKCHAIN_EXPLORER_URL=
ISSUER_WALLET_ADDRESS=0x70997970C51812dc3A010C7d01b50e0d17dc79C8
# Development-only well-known Hardhat account key (Never use in production)
ISSUER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

# Optional Ethereum Sepolia Testnet Configuration
# SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/your-infura-api-key
# SEPOLIA_CHAIN_ID=11155111
# SEPOLIA_CONTRACT_ADDRESS=
# SEPOLIA_EXPLORER_URL=https://sepolia.etherscan.io
